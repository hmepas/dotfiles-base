# === OS / editor junk that may appear inside the repo ===
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# === Local tool caches ===
.pre-commit-cache/

# === Machine-specific override files ===
# Committed templates: foo.local.example
# Uncommitted machine overrides land in ~ directly (not in stow).
# NB: do NOT add '*.local' here — it would also ignore load-bearing dirs
# like stow/shell/.zshrc.local/ whose name ends in '.local'.

# === Safety net: if a secret file is ever accidentally cp'd into a stow package ===
# (Secrets live in $HOME only; this is double-protection against carelessness.)
.zshrc.secret
.gitconfig.local
*.key
*.pem
*_token
*-token
*.secret
