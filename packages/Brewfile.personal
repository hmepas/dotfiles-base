# Brewfile.personal — an extension over Brewfile for a personal Mac.
#
# Usage (personal machine only):
#   brew bundle --file=packages/Brewfile.personal
#

# ===== Taps =====
tap "acsandmann/tap"
tap "anomalyco/tap"
tap "daipeihust/tap"
tap "felixkratz/formulae"
tap "hmepas/throt"
#tap "minio/stable"
tap "oven-sh/bun"

# ===== Custom / specific tools =====
brew "hmepas/throt/throt"
brew "daipeihust/tap/im-select"
brew "anomalyco/tap/opencode"
#brew "minio/stable/mc"

# ===== Window manager (SIP-disabled host) =====
# yabai + JankyBorders + Übersicht referenced from stow/macos-personal/.yabairc
# and stow/macos-yabai-scripts. SA features need SIP off — personal mac only.
# yabai is NOT installed via brew: upstream (asmvik/yabai) has no macOS 27
# support, so it is built from the AhsanFazal/yabai fork:
#   git clone https://github.com/AhsanFazal/yabai ~/projects/yabai-ahsanfazal
#   cd ~/projects/yabai-ahsanfazal && make install
#   codesign -fs yabai-cert-20261106 bin/yabai   # self-signed cert in login keychain
#   cp bin/yabai /opt/homebrew/bin/yabai
#   sudo yabai --load-sa && yabai --start-service
brew "felixkratz/formulae/borders"
cask "ubersicht"

# ===== Network / tunnels =====
brew "frpc"
brew "dnsmasq"

# ===== AI / agents =====
#cask "block-goose"
cask "codex"
brew "gemini-cli"
brew "hf"

# ===== AI / agents CLI =====
#cask "visual-studio-code"

# ===== Media / productivity =====
brew "duti"
brew "ffmpeg"
brew "mkvtoolnix"
brew "sox"
cask "alt-tab"
cask "android-file-transfer"
#cask "jordanbaird-ice"
cask "helium-browser"
cask "iina"
cask "kawa"
cask "keyclu"
cask "losslesscut"
cask "neovide-app"
cask "obs"
cask "rar"
cask "unnaturalscrollwheels"
