# Brewfile.personal — an extension over Brewfile for a personal Mac.
#
# Usage (personal machine only):
#   brew bundle --file=packages/Brewfile.personal
#

# ===== Taps =====
tap "acsandmann/tap"
tap "anomalyco/tap"
tap "daipeihust/tap"
tap "felixkratz/formulae"
tap "hmepas/throt"
tap "koekeishiya/formulae"
#tap "minio/stable"
tap "oven-sh/bun"

# ===== Custom / specific tools =====
brew "hmepas/throt/throt"
brew "daipeihust/tap/im-select"
brew "anomalyco/tap/opencode"
#brew "minio/stable/mc"

# ===== Window manager (SIP-disabled host) =====
# yabai + JankyBorders + Übersicht referenced from stow/macos-personal/.yabairc
# and stow/macos-yabai-scripts. SA features need SIP off — personal mac only.
brew "koekeishiya/formulae/yabai"
brew "felixkratz/formulae/borders"
cask "ubersicht"

# ===== Network / tunnels =====
brew "frpc"
brew "dnsmasq"

# ===== AI / agents =====
#cask "block-goose"
cask "codex"
brew "gemini-cli"
brew "hf"

# ===== AI / agents CLI =====
#cask "visual-studio-code"

# ===== Media / productivity =====
brew "ffmpeg"
brew "mkvtoolnix"
brew "sox"
cask "alt-tab"
cask "android-file-transfer"
#cask "jordanbaird-ice"
cask "helium-browser"
cask "kawa"
cask "keyclu"
cask "losslesscut"
cask "neovide-app"
cask "obs"
cask "rar"
cask "unnaturalscrollwheels"
