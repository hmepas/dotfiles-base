#!/bin/bash

# ├───────────────────────────────┼────────────────────────────────────────────────────────────────────┤
# │ Ручной старт (systemd)        │ systemctl --user start homebrew.colima.service                     │
# ├───────────────────────────────┼────────────────────────────────────────────────────────────────────┤
# │ Ручной старт (рядом с colima) │ colima start -f                                                    │
# ├───────────────────────────────┼────────────────────────────────────────────────────────────────────┤
# │ Проверить, что бежит          │ systemctl --user status homebrew.colima.service  или colima status │
# ├───────────────────────────────┼────────────────────────────────────────────────────────────────────┤
# │ Остановить                    │ systemctl --user stop homebrew.colima.service  или colima stop -f  │
# ├───────────────────────────────┼────────────────────────────────────────────────────────────────────┤
# │ Включить автозапуск снова     │ systemctl --user enable homebrew.colima.service                    │
# └───────────────────────────────┴────────────────────────────────────────────────────────────────────┘

systemctl --user start homebrew.colima.service
