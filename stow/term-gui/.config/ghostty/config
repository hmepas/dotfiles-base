# Shared Ghostty config (Mac + Linux desktop).
# OS-specific bits live in overlays shipped by OS stow packages:
#   macos.conf  <- stow/macos-common
#   linux.conf  <- stow/linux-desktop
# Overlays load after this file (Ghostty rule for config-file), so they win.
# NB: '#' is a comment only at line start; no trailing comments after values.

font-family = Hack Nerd Font Mono
theme = Catppuccin Mocha
mouse-hide-while-typing = true
window-decoration = true
background-opacity = 0.7

clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
copy-on-select = clipboard

config-file = ?macos.conf
config-file = ?linux.conf
