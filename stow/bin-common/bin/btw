#!/usr/bin/env node

import { constants as osConstants, homedir, tmpdir } from "node:os";
import { mkdtemp, rm } from "node:fs/promises";
import { join } from "node:path";
import { spawn } from "node:child_process";
import { createInterface } from "node:readline/promises";
import process from "node:process";

const FAST_EXIT_CHILD = "BTW_PI_FAST_EXIT_CHILD";
const SELF_IMPORT = `--import=${import.meta.url}`;

function installFastExitHook() {
  const write = process.stdout.write.bind(process.stdout);
  let done = false;

  const unrefTlsSockets = () => {
    for (const handle of process._getActiveHandles()) {
      if (handle?.constructor?.name === "TLSSocket") {
        handle.unref?.();
      }
    }
  };

  process.stdout.write = function (chunk, encoding, callback) {
    const cb = typeof encoding === "function" ? encoding : callback;
    const enc = typeof encoding === "string" ? encoding : undefined;

    return write(chunk, enc, (...args) => {
      cb?.(...args);
      if (done || String(chunk).length === 0) return;
      done = true;

      // Pi has already produced its final print-mode output. Let its normal
      // cleanup run, but stop the completed HTTPS keep-alive socket from
      // holding the one-shot process open for another ~2 seconds.
      setTimeout(() => {
        unrefTlsSockets();
        const timer = setInterval(unrefTlsSockets, 10);
        timer.unref();
        setTimeout(() => clearInterval(timer), 250).unref();
      }, 25);
    });
  };
}

async function getPrompt(args) {
  if (args.length > 0) return args.join(" ");

  if (!process.stdin.isTTY) {
    let input = "";
    process.stdin.setEncoding("utf8");
    for await (const chunk of process.stdin) input += chunk;
    return input.trim();
  }

  const rl = createInterface({ input: process.stdin, output: process.stderr });
  try {
    return await rl.question("btw> ");
  } finally {
    rl.close();
  }
}

function selectedModel() {
  if (process.env.BTW_MODEL) return process.env.BTW_MODEL;
  if (process.env.PI_PROVIDER && process.env.PI_MODEL) {
    return `${process.env.PI_PROVIDER}/${process.env.PI_MODEL}`;
  }
  return "openai-codex/gpt-6-luna";
}

function nodeOptionsWithSelfImport() {
  const existing = process.env.NODE_OPTIONS?.trim();
  return existing ? `${existing} ${SELF_IMPORT}` : SELF_IMPORT;
}

function runPi(args, cwd) {
  const child = spawn("pi", args, {
    cwd,
    stdio: "inherit",
    env: {
      ...process.env,
      [FAST_EXIT_CHILD]: "1",
      NODE_OPTIONS: nodeOptionsWithSelfImport(),
    },
  });

  return new Promise((resolve, reject) => {
    const handlers = new Map();
    for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) {
      const handler = () => child.kill(signal);
      handlers.set(signal, handler);
      process.on(signal, handler);
    }

    const cleanupHandlers = () => {
      for (const [signal, handler] of handlers) process.off(signal, handler);
    };

    child.once("error", (error) => {
      cleanupHandlers();
      reject(error);
    });
    child.once("close", (code, signal) => {
      cleanupHandlers();
      resolve(code ?? (signal ? 128 + (osConstants.signals[signal] ?? 0) : 1));
    });
  });
}

async function main() {
  const prompt = await getPrompt(process.argv.slice(2));
  if (!prompt.trim()) {
    console.error("btw: empty prompt");
    process.exitCode = 1;
    return;
  }

  const cwd = await mkdtemp(join(tmpdir(), "btw-"));
  try {
    process.exitCode = await runPi(
      [
        "--print",
        "--no-session",
        "--offline",
        "--model",
        selectedModel(),
        "--thinking",
        process.env.BTW_THINKING || "off",
        "--no-tools",
        "--no-extensions",
        "--extension",
        join(homedir(), ".pi", "agent", "extensions", "openai-fast.ts"),
        "--no-mcp",
        "--no-skills",
        "--no-prompt-templates",
        "--no-themes",
        "--no-context-files",
        "--no-approve",
        "--system-prompt",
        " ",
        "--append-system-prompt",
        "",
        "--",
        prompt,
      ],
      cwd,
    );
  } catch (error) {
    console.error(`btw: ${error instanceof Error ? error.message : String(error)}`);
    process.exitCode = 1;
  } finally {
    await rm(cwd, { recursive: true, force: true });
  }
}

if (process.env[FAST_EXIT_CHILD] === "1") {
  installFastExitHook();
} else {
  await main();
}
